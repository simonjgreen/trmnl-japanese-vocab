{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simonjgreen.github.io/trmnl-japanese-vocab/schemas/daily-payload.schema.json",
  "title": "Kotoba daily deck",
  "description": "One day's deck of flash cards for a level and every easier level. The plugin picks a card from `words` using the current timestamp.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "level", "level_display", "dataset_version", "selection_version", "deck", "words"],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "level": { "enum": ["n5", "n4", "n3", "n2", "n1"] },
    "level_display": { "enum": ["N5", "N4", "N3", "N2", "N1"] },
    "dataset_version": { "type": "string", "minLength": 1 },
    "selection_version": { "type": "string", "minLength": 1 },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "slot_seconds", "pool"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "slot_seconds": { "type": "integer", "minimum": 1 },
        "pool": {
          "type": "integer",
          "minimum": 1,
          "description": "Total active words available at this level and below."
        }
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "reading", "ruby_segments", "display_gloss", "level", "display", "sequence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "reading": { "type": "string", "minLength": 1 },
          "level": { "enum": ["N5", "N4", "N3", "N2", "N1"] },
          "ruby_segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["base", "reading"],
              "properties": {
                "base": { "type": "string", "minLength": 1 },
                "reading": { "type": ["string", "null"], "minLength": 1 }
              }
            }
          },
          "display_gloss": { "type": "string", "minLength": 1, "maxLength": 90 },
          "example": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ja"],
            "properties": {
              "ja": { "type": "string", "minLength": 1, "maxLength": 80 },
              "en": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          },
          "display": {
            "type": "object",
            "additionalProperties": false,
            "required": ["word_size", "example_size"],
            "properties": {
              "word_size": { "enum": ["short", "medium", "long", "xlong"] },
              "example_size": { "enum": ["normal", "compact", "tiny"] }
            }
          },
          "sequence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "total"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "total": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
