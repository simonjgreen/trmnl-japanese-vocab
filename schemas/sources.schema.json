{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Kotoba data provenance register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "dependentRequired": {
          "files": [
            "upstream"
          ]
        },
        "required": [
          "id",
          "name",
          "homepage",
          "licence",
          "licence_url",
          "attribution",
          "fields_used",
          "retrieved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "retrieved": {
            "type": "string",
            "minLength": 4
          },
          "version": {
            "type": "string"
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "licence_url": {
            "type": "string",
            "format": "uri"
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "fields_used": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "upstream": {
            "description": "Whether the download URL names an immutable release artefact (pinned) or follows a branch head that may legitimately move (head-tracked). Determines whether a digest mismatch is an error or a warning.",
            "type": "string",
            "enum": [
              "pinned",
              "head-tracked"
            ]
          },
          "files": {
            "description": "Every file this source contributes to data/raw, with its SHA-256. One entry, one digest: notes about the digests belong in redistribution_notes or a YAML comment, never inside the digest itself.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^data/raw/[A-Za-z0-9._/-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "redistribution_notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
