{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simonjgreen.github.io/trmnl-japanese-vocab/schemas/vocabulary-entry.schema.json",
  "title": "Kotoba canonical vocabulary entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "surface", "reading", "ruby_segments", "glosses", "display_gloss", "jlpt", "source_refs", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+:[^\\s]+$" },
    "surface": { "type": "string", "minLength": 1 },
    "reading": { "type": "string", "minLength": 1 },
    "ruby_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base", "reading"],
        "properties": {
          "base": { "type": "string", "minLength": 1 },
          "reading": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "glosses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "display_gloss": { "type": "string", "minLength": 1, "maxLength": 90 },
    "part_of_speech": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "jlpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "source_id"],
      "properties": {
        "level": { "enum": ["N5", "N4", "N3", "N2", "N1"] },
        "source_id": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja"],
      "properties": {
        "ja": { "type": "string", "minLength": 1, "maxLength": 80 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 },
        "focus_form": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_entry_id": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["active", "disabled"] },
    "notes": { "type": ["string", "null"] }
  }
}
