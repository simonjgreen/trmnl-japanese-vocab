# Raw third-party source downloads (licence-dependent; not redistributed)
data/raw/*
!data/raw/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Rendered artefacts
*.png
!docs/images/*.png

# OS
.DS_Store

# The original prompt/specification this project was built from. Kept locally
# for provenance; not tracked, because the implementation has since moved on
# from it (word-of-the-day and the date-based API are both retired) and a
# stale spec in-tree is worse than none. The design decisions that superseded
# it are recorded in docs/adr/.
trmnl-kotoba-claude-goal.md
